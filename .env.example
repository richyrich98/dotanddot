# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_REDIRECT_URL=http://localhost:3000
VITE_SUPABASE_ANON_KEY=your-anon-key

# Mapbox Configuration (Required for 3D map features)
# Get your token from: https://account.mapbox.com/
# Without this token, the app will fall back to MapLibre GL (2D maps only)
VITE_MAPBOX_TOKEN=your-mapbox-token-here